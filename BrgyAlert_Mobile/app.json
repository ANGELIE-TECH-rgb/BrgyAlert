{
  "expo": {
    "name": "BrgyAlert_Mobile",
    "slug": "BrgyAlert_Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.anonymous.BrgyAlert_Mobile",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD6dt6618BrcQrz8othFF1pyujiiHjwrY8"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.82872757022-h2u32c6r7h6k1q3l58399g5v3k552b7v"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F2C59"
        }
      ]
    ]
  }
}

