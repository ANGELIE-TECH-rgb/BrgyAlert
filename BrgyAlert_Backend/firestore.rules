rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for citizen reports/alerts
    match /alerts/{alertId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();

      // Rules for incident chat messages
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Helper: check if the requesting user owns this document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: check if requesting user is an admin or responder
    function isAdminOrResponder() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'responder');
    }

    // Rules for user profiles
    match /users/{userId} {
      // Create: only the authenticated user can create their own profile.
      // We also verify the uid field in the written data matches the auth uid
      // to prevent one user from writing a profile for another user.
      allow create: if isOwner(userId)
                    && request.resource.data.uid == request.auth.uid;

      // Read: owner OR admin/responder (so responders can view reporter profiles)
      allow read: if isOwner(userId) || isAdminOrResponder();

      // Update / delete: owner only
      allow update, delete: if isOwner(userId);

      // Rules for user notifications
      match /notifications/{notificationId} {
        // Read: owner only
        allow read: if isOwner(userId);
        // Write: owner OR admin/responder (so admin/responders can trigger updates)
        allow write: if isOwner(userId) || isAdminOrResponder();
      }
    }

    // Rules for responders
    match /responders/{responderId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for evacuation centers
    match /evacuation_centers/{centerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for broadcasts
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for SMS logs (Only backend/admin SDK, block client access)
    match /sms_logs/{logId} {
      allow read, write: if false;
    }

    // Rules for emergency contacts
    match /emergency_contacts/{contactId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for barangay configurations
    match /config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

