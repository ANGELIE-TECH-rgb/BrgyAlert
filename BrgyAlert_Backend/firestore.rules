rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for citizen reports/alerts
    match /alerts/{alertId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Rules for user profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for responders
    match /responders/{responderId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for evacuation centers
    match /evacuation_centers/{centerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for broadcasts
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for SMS logs (Only backend/admin SDK, block client access)
    match /sms_logs/{logId} {
      allow read, write: if false;
    }

    // Rules for emergency contacts
    match /emergency_contacts/{contactId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

